# Copy to .env.local for local development. On Vercel, set these in Project › Settings › Environment Variables.
# All values are PUBLIC by design (static app, no server). Never put a secret here.

# OAuth 2.0 Web client ID from the Google Cloud project "CleverAds Operations"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Only accounts from this Google Workspace domain may sign in
NEXT_PUBLIC_ALLOWED_DOMAIN=cleverads.com.au
# Spreadsheet ID of the Hub Data sheet (advertisers, ad types, logs, messages)
NEXT_PUBLIC_HUB_DATA_SHEET_ID=
# Where "Contact the developer" messages are sent (not shown on screen)
NEXT_PUBLIC_DEVELOPER_EMAIL=mr.taifur@gmail.com
# Default clock time zone on Home (display only)
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Australia/Sydney
# Time zone for all calculations and report sheets (TODAY, days left, Urgent), same as the Apps Script
NEXT_PUBLIC_REPORT_TIME_ZONE=Asia/Dhaka
# Local preview only: click through the screens without Google. Leave empty on Vercel.
NEXT_PUBLIC_DEMO_MODE=
